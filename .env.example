# Copy to .env for local dev. docker-compose provides the Postgres below.
DATABASE_URL=postgresql+psycopg://okf:okf@localhost:5433/okf
TEST_DATABASE_URL=postgresql+psycopg://okf:okf@localhost:5433/okf_test

# Embeddings (local sentence-transformers by default, or set GEMINI_API_KEY for cloud)
EMBEDDINGS_ENABLED=false
GEMINI_API_KEY=

# Auth & Private Cloud Mode (leave PRIVATE_MODE=false for open local dev)
PRIVATE_MODE=false
API_KEY=
SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_GITHUB_LOGIN=
GITHUB_WEBHOOK_SECRET=
